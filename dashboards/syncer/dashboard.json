          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Inactive"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Active"
                },
                "2": {
                  "color": "yellow",
                  "index": 2,
